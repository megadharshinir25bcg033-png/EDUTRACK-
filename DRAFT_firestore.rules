    // Admin Staff Registry
    match /staff/{staffId} {
      allow get: if isValidId(staffId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
