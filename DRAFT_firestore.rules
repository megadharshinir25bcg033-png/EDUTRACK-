    }

    // Announcements
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
