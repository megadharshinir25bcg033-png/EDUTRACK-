    // AI Study Threads
    match /aiThreads/{threadId} {
      allow get: if isValidId(threadId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
