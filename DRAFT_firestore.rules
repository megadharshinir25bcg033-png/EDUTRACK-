    }

    // Calendar Events
    match /calendarEvents/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
