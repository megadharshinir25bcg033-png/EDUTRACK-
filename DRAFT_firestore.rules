rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'megadharshinir25bcg033@skasc.ac.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin registry locked down from client writes
    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, create, update, delete: if false;
    }

    // Connection probe document
    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
      allow list, write: if false;
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'institutionalId', 'department', 'semester',
          'activePortalView', 'themeMode', 'interfaceDensity',
          'notifyAssignments', 'notifyAttendance', 'notifyExams', 'notifyBroadcasts',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'institutionalId', 'department', 'semester',
          'activePortalView', 'themeMode', 'interfaceDensity',
          'notifyAssignments', 'notifyAttendance', 'notifyExams', 'notifyBroadcasts',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.institutionalId is string && data.institutionalId.size() >= 1 && data.institutionalId.size() <= 40
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 120
        && data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 60
        && data.activePortalView in ['student', 'faculty', 'admin']
        && data.themeMode in ['light', 'dark']
        && data.interfaceDensity in ['standard', 'compact']
        && data.notifyAssignments is bool
        && data.notifyAttendance is bool
        && data.notifyExams is bool
        && data.notifyBroadcasts is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'address', 'dob', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'address', 'dob', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 240
        && data.dob is string && data.dob.size() >= 1 && data.dob.size() <= 60
        && data.updatedAt is timestamp;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll([
          'ownerUid', 'code', 'title', 'description', 'courseCode', 'courseName',
          'facultyName', 'targetSection', 'dueDate', 'dueWindow', 'maxMarks',
          'status', 'progressPct', 'submissionCount', 'totalStudents', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'code', 'title', 'description', 'courseCode', 'courseName',
          'facultyName', 'targetSection', 'dueDate', 'dueWindow', 'maxMarks',
          'status', 'progressPct', 'submissionCount', 'totalStudents', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 30
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 500
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseName is string && data.courseName.size() >= 2 && data.courseName.size() <= 120
        && data.facultyName is string && data.facultyName.size() >= 2 && data.facultyName.size() <= 100
        && data.targetSection is string && data.targetSection.size() >= 2 && data.targetSection.size() <= 60
        && data.dueDate is string && data.dueDate.size() >= 2 && data.dueDate.size() <= 60
        && data.dueWindow is string && data.dueWindow.size() >= 1 && data.dueWindow.size() <= 60
        && data.maxMarks is number && data.maxMarks >= 1 && data.maxMarks <= 1000
        && data.status in ['Pending', 'In Progress', 'Submitted', 'Graded', 'Active', 'Extended', 'Closed']
        && data.progressPct is number && data.progressPct >= 0 && data.progressPct <= 100
        && data.submissionCount is number && data.submissionCount >= 0
        && data.totalStudents is number && data.totalStudents >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
          'ownerUid', 'assignmentId', 'assignmentTitle', 'courseCode',
          'studentName', 'studentRoll', 'fileName', 'fileSize', 'notes',
          'marks', 'maxMarks', 'feedback', 'grade', 'status', 'submittedAtLabel',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'assignmentId', 'assignmentTitle', 'courseCode',
          'studentName', 'studentRoll', 'fileName', 'fileSize', 'notes',
          'marks', 'maxMarks', 'feedback', 'grade', 'status', 'submittedAtLabel',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.assignmentId is string && data.assignmentId.size() >= 1 && data.assignmentId.size() <= 128
        && data.assignmentTitle is string && data.assignmentTitle.size() >= 2 && data.assignmentTitle.size() <= 160
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120
        && data.studentRoll is string && data.studentRoll.size() >= 2 && data.studentRoll.size() <= 40
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && data.fileSize is string && data.fileSize.size() >= 1 && data.fileSize.size() <= 30
        && data.notes is string && data.notes.size() <= 600
        && data.marks is number && data.marks >= 0 && data.marks <= 1000
        && data.maxMarks is number && data.maxMarks >= 1 && data.maxMarks <= 1000
        && data.feedback is string && data.feedback.size() <= 400
        && data.grade is string && data.grade.size() <= 20
        && data.status in ['On-Time', 'Pending Review', 'Late', 'Graded', 'Submitted']
        && data.submittedAtLabel is string && data.submittedAtLabel.size() >= 1 && data.submittedAtLabel.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
          'ownerUid', 'date', 'dayLabel', 'timeSlot', 'courseCode',
          'courseTitle', 'room', 'faculty', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'date', 'dayLabel', 'timeSlot', 'courseCode',
          'courseTitle', 'room', 'faculty', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 40
        && data.dayLabel is string && data.dayLabel.size() >= 2 && data.dayLabel.size() <= 40
        && data.timeSlot is string && data.timeSlot.size() >= 2 && data.timeSlot.size() <= 40
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 120
        && data.room is string && data.room.size() >= 2 && data.room.size() <= 40
        && data.faculty is string && data.faculty.size() >= 2 && data.faculty.size() <= 100
        && data.status in ['Present', 'Absent', 'Leave/OD', 'Holiday']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll([
          'ownerUid', 'courseCode', 'leaveType', 'fromDate', 'toDate',
          'reason', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'courseCode', 'leaveType', 'fromDate', 'toDate',
          'reason', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.leaveType in ['Medical Waiver', 'On-Duty (Hackathon/Event)', 'Academic Leave']
        && data.fromDate is string && data.fromDate.size() >= 4 && data.fromDate.size() <= 30
        && data.toDate is string && data.toDate.size() >= 4 && data.toDate.size() <= 30
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 400
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGradeRecord(data) {
      return data.keys().hasAll([
          'ownerUid', 'semester', 'examType', 'courseCode', 'courseName',
          'credits', 'maxMarks', 'score', 'classAvg', 'grade', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'semester', 'examType', 'courseCode', 'courseName',
          'credits', 'maxMarks', 'score', 'classAvg', 'grade', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.semester is string && data.semester.size() >= 2 && data.semester.size() <= 40
        && data.examType in ['Semester V Final', 'Model Examination', 'Internal Assessment']
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseName is string && data.courseName.size() >= 2 && data.courseName.size() <= 140
        && data.credits is number && data.credits >= 1 && data.credits <= 10
        && data.maxMarks is number && data.maxMarks >= 1 && data.maxMarks <= 1000
        && data.score is number && data.score >= 0 && data.score <= 1000
        && data.classAvg is number && data.classAvg >= 0 && data.classAvg <= 1000
        && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyMaterial(data) {
      return data.keys().hasAll([
          'ownerUid', 'courseCode', 'courseName', 'title', 'topic', 'facultyName',
          'fileType', 'categoryTag', 'badgeTag', 'fileSize', 'isCached', 'isRead',
          'updatedLabel', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'courseCode', 'courseName', 'title', 'topic', 'facultyName',
          'fileType', 'categoryTag', 'badgeTag', 'fileSize', 'isCached', 'isRead',
          'updatedLabel', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseName is string && data.courseName.size() >= 2 && data.courseName.size() <= 120
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 180
        && data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 120
        && data.facultyName is string && data.facultyName.size() >= 2 && data.facultyName.size() <= 100
        && data.fileType in ['PDF Notes', 'PPT Slides', 'Lab Code', 'Q-Banks']
        && data.categoryTag is string && data.categoryTag.size() >= 1 && data.categoryTag.size() <= 40
        && data.badgeTag is string && data.badgeTag.size() >= 1 && data.badgeTag.size() <= 40
        && data.fileSize is string && data.fileSize.size() >= 1 && data.fileSize.size() <= 30
        && data.isCached is bool
        && data.isRead is bool
        && data.updatedLabel is string && data.updatedLabel.size() >= 1 && data.updatedLabel.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll([
          'ownerUid', 'category', 'badgeLabel', 'department', 'title', 'summary',
          'author', 'dateLabel', 'attachmentLabel', 'isUnread', 'isBookmarked',
          'isHighPriority', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'category', 'badgeLabel', 'department', 'title', 'summary',
          'author', 'dateLabel', 'attachmentLabel', 'isUnread', 'isBookmarked',
          'isHighPriority', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.category in ['Important', 'Academic', 'Examination', 'Events']
        && data.badgeLabel is string && data.badgeLabel.size() >= 2 && data.badgeLabel.size() <= 40
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 100
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 180
        && data.summary is string && data.summary.size() >= 4 && data.summary.size() <= 600
        && data.author is string && data.author.size() >= 2 && data.author.size() <= 100
        && data.dateLabel is string && data.dateLabel.size() >= 2 && data.dateLabel.size() <= 50
        && data.attachmentLabel is string && data.attachmentLabel.size() <= 60
        && data.isUnread is bool
        && data.isBookmarked is bool
        && data.isHighPriority is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll([
          'ownerUid', 'title', 'courseCode', 'category', 'dateStr',
          'timeRange', 'location', 'description', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'title', 'courseCode', 'category', 'dateStr',
          'timeRange', 'location', 'description', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 30
        && data.category in ['Academic Events', 'Assignments', 'Holidays', 'Examinations']
        && data.dateStr is string && data.dateStr.size() >= 8 && data.dateStr.size() <= 20
        && data.timeRange is string && data.timeRange.size() >= 2 && data.timeRange.size() <= 60
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 100
        && data.description is string && data.description.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentRegistry(data) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'registerNo', 'department', 'specialization', 'yearSem',
          'email', 'phone', 'admittedTerm', 'attendancePct', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'registerNo', 'department', 'specialization', 'yearSem',
          'email', 'phone', 'admittedTerm', 'attendancePct', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.registerNo is string && data.registerNo.size() >= 2 && data.registerNo.size() <= 40
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 100
        && data.specialization is string && data.specialization.size() >= 2 && data.specialization.size() <= 100
        && data.yearSem is string && data.yearSem.size() >= 2 && data.yearSem.size() <= 40
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 140
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.admittedTerm is string && data.admittedTerm.size() >= 2 && data.admittedTerm.size() <= 40
        && data.attendancePct is number && data.attendancePct >= 0 && data.attendancePct <= 100
        && data.status in ['Active', 'On Leave', 'Probation']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffRegistry(data) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'staffId', 'department', 'designation', 'email',
          'phone', 'coursesCount', 'weeklyHours', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'staffId', 'department', 'designation', 'email',
          'phone', 'coursesCount', 'weeklyHours', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.staffId is string && data.staffId.size() >= 2 && data.staffId.size() <= 40
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 100
        && data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 140
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.coursesCount is number && data.coursesCount >= 0 && data.coursesCount <= 20
        && data.weeklyHours is number && data.weeklyHours >= 0 && data.weeklyHours <= 80
        && data.status in ['Active', 'Sabbatical', 'Inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiThread(data) {
      return data.keys().hasAll([
          'ownerUid', 'title', 'courseCode', 'subtitle', 'timeLabel', 'messages', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'title', 'courseCode', 'subtitle', 'timeLabel', 'messages', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 30
        && data.subtitle is string && data.subtitle.size() <= 180
        && data.timeLabel is string && data.timeLabel.size() <= 40
        && data.messages is list && data.messages.size() <= 50
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users & Isolated Private PII
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'institutionalId', 'department', 'semester',
            'activePortalView', 'themeMode', 'interfaceDensity',
            'notifyAssignments', 'notifyAttendance', 'notifyExams', 'notifyBroadcasts',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && (isOwner(userId) || isAdmin())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'address', 'dob', 'updatedAt']);
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(assignmentId)
        && isValidAssignment(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(assignmentId)
        && isValidAssignment(incoming())
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'dueDate', 'dueWindow', 'maxMarks', 'status', 'progressPct', 'submissionCount', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser() && isValidId(assignmentId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Submissions & Faculty Grading Ledger
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(submissionId)
        && isValidSubmission(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(submissionId)
        && isValidSubmission(incoming())
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fileName', 'fileSize', 'notes', 'marks', 'feedback', 'grade', 'status', 'submittedAtLabel', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser() && isValidId(submissionId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Attendance Records
    match /attendance/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(recordId)
        && isValidAttendanceRecord(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(recordId)
        && isValidAttendanceRecord(incoming())
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(recordId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Leave & OD Requests (with Terminal State Locking)
    match /leaveRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && existing().status == 'Pending'
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'fromDate', 'toDate', 'status', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(requestId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Grade Records
    match /grades/{gradeId} {
